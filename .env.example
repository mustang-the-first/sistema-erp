# Copy to .env and adjust. Never commit .env.
ERP_ENV=development
ERP_DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/erp
ERP_TEST_DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/erp_test
ERP_POINT_OF_SALE=1

# Required in production (the app refuses to start without them):
#   ERP_DATABASE_URL (or DATABASE_URL; postgres:// URLs are accepted)
#   ERP_SECRET_KEY: at least 32 random chars, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# ERP_SECRET_KEY=

# Public demo: locks demo accounts, shows the "demo" banner, allows scripts.reset_demo.
# ERP_DEMO_MODE=true
# ERP_DEMO_PASSWORD=   # required (>= 8 chars) in production when ERP_DEMO_MODE=true
